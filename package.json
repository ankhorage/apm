{
  "name": "@ankhorage/apm",
  "version": "0.8.15",
  "type": "module",
  "description": "Headless project update analysis, planning, execution, recovery, and verification for Ankhorage tooling.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/apm.git"
  },
  "homepage": "https://github.com/ankhorage/apm#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/apm/issues"
  },
  "keywords": [
    "ankhorage",
    "cli",
    "dependencies",
    "migrations",
    "package-manager",
    "typescript",
    "updates"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples"
  ],
  "exports": {
    "./types": {
      "types": "./dist/types/public.d.ts",
      "import": "./dist/types/public.js"
    },
    ".": {
      "types": "./dist/apm.d.ts",
      "import": "./dist/apm.js"
    },
    "./node": {
      "types": "./dist/nodeApm.d.ts",
      "import": "./dist/nodeApm.js"
    },
    "./cli": {
      "types": "./dist/cli/createCliProvider.d.ts",
      "import": "./dist/cli/createCliProvider.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "apm": "./dist/cli/runAsync.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@ankhorage/ankh": "^0.13.1"
  },
  "peerDependenciesMeta": {
    "@ankhorage/ankh": {
      "optional": true
    }
  },
  "ankh": {
    "category": "apm",
    "provider": "./dist/cli/provider.js",
    "capabilities": [
      {
        "id": "apm.status",
        "owner": "@ankhorage/apm",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Inspect project update status",
        "description": "Inspect dependency, installation, projection, migration and availability evidence."
      },
      {
        "id": "apm.plan",
        "owner": "@ankhorage/apm",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Plan project updates",
        "description": "Resolve a concrete reviewable update plan without mutating the project."
      },
      {
        "id": "apm.apply",
        "owner": "@ankhorage/apm",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Apply project updates",
        "description": "Apply a selected still-valid update plan with recovery semantics."
      },
      {
        "id": "apm.verify",
        "owner": "@ankhorage/apm",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Verify project updates",
        "description": "Verify the applied dependency graph, migrations, projections, and required checks."
      }
    ]
  },
  "ankhorage": {
    "renovateSyncProtocol": 1
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run check-types",
    "test": "bun test src",
    "docs": "paradox",
    "changeset": "ankhorage-changeset",
    "prepack": "bun run build",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version"
  },
  "dependencies": {
    "@ankhorage/contracts": "^26.0.0",
    "@ankhorage/project-detector": "^0.1.0",
    "@ankhorage/utility": "^1.4.0",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@ankhorage/ankh": "^0.13.3",
    "@ankhorage/capability": "^0.2.1",
    "@ankhorage/devtools": "^2.3.39",
    "@ankhorage/paradox": "^0.1.26",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
